# SocialSync server configuration. Copy to .env (on the VPS: /root/socialsync-app/.env, chmod 600).
# NEVER commit real values. Generate secrets with: openssl rand -hex 32

# --- Core (required) ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3460
APP_URL=https://socialsync.aisetuppros.com
# >= 32 random chars; the server refuses to start with a weak/default value
SESSION_SECRET=
# 32 bytes as 64 hex chars (or base64). Encrypts stored social tokens. Losing it = reconnect all accounts.
TOKEN_ENCRYPTION_KEY=
# Where encrypted tokens + the scheduled-post queue are stored (default ./data)
DATA_DIR=

# --- Who may sign in (required) ---
# Firebase project the web app signs in to (same value as VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=
# Comma-separated Google/Firebase emails allowed to use the app
ALLOWED_EMAILS=
# Optional: Firebase user UIDs allowed (alternative to emails)
ALLOWED_UIDS=
# Only for email/password users whose email is not verified in Firebase (not recommended)
ALLOW_UNVERIFIED_EMAIL=false
ALLOW_ANY_FIREBASE_USER=false

# --- Firebase web config (build time; public by design, ends up in the browser bundle) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Only if the app uses a named Firestore database (AI Studio projects do)
VITE_FIRESTORE_DATABASE_ID=

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
# native = SocialSync publishes itself (default); n8n = hand due posts to N8N_WEBHOOK_URL instead
PUBLISH_MODE=native
N8N_WEBHOOK_URL=

# --- AI (server-side only) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Meta: Facebook Pages + Instagram Business (one app covers both) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional: "Facebook Login for Business" configuration id (use instead of scopes)
FACEBOOK_LOGIN_CONFIG_ID=
# Optional overrides
FACEBOOK_GRAPH_VERSION=v24.0
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish,business_management

# --- LinkedIn personal profile (app with "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn") ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=openid profile w_member_social

# --- LinkedIn company Page (SEPARATE app with ONLY the "Community Management API" product) ---
LINKEDIN_ORG_CLIENT_ID=
LINKEDIN_ORG_CLIENT_SECRET=
LINKEDIN_ORG_SCOPES=r_basicprofile w_organization_social r_organization_social rw_organization_admin
# LinkedIn monthly API version (YYYYMM). Versions sunset after ~1 year; bump when LinkedIn warns.
LINKEDIN_API_VERSION=202610

# --- X / Twitter (optional; posting requires a paid X API tier) ---
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
